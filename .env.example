# Copy to .env and replace the example credentials.
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=auth_db

# Keep these credentials and database name in sync with the values above.
# The host must be the Compose service name, postgres. URL-encode special
# characters in the password when writing DATABASE_URL.
DATABASE_URL=postgres://auth_user:replace_with_a_strong_password@postgres:5432/auth_db?sslmode=disable
NODE_ENV=production
PORT=3000
DATABASE_MAX=10
DATABASE_IDLE_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
DATABASE_MAX_LIFETIME=3600
DATABASE_PREPARE=true
